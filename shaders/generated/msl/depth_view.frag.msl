#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> depth_texture [[texture(0)]], sampler depth_sampler [[sampler(0)]])
{
    main0_out out = {};
    float _30 = sqrt(fast::clamp(1.0 - depth_texture.sample(depth_sampler, in.in_var_TEXCOORD0).x, 0.0, 1.0));
    out.out_var_SV_Target0 = float4(_30, _30, _30, 1.0);
    return out;
}

