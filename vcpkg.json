{
  "name": "moteur",
  "version-string": "0.8.0",
  "builtin-baseline": "5f96cd15fd745122cf27e0524606d6c1efc5fd07",
  "dependencies": [
    "sdl3",
    "glm",
    "stb",
    "doctest",
    "nlohmann-json",
    "cgltf",
    "mikktspace",
    "entt",
    "efsw",
    "miniaudio",
    "ozz-animation",
    "zstd",
    "recastnavigation",
    {
      "name": "harfbuzz",
      "default-features": false
    },
    {
      "name": "ktx",
      "features": ["tools"]
    },
    {
      "name": "imgui",
      "features": ["sdl3-binding", "sdlgpu3-binding"]
    },
    {
      "name": "sdl3-shadercross",
      "platform": "windows"
    },
    {
      "name": "winpixevent",
      "platform": "windows & !staticcrt"
    }
  ],
  "features": {
    "mac-shaders": {
      "description": "macOS: the shaders compiled on the Mac itself (option MOTEUR_MAC_SHADERCROSS) instead of the MSL generated on Windows; needs the LunarG Vulkan SDK (its DXC). Not tried yet.",
      "dependencies": [
        {
          "name": "sdl3-shadercross-macos",
          "platform": "osx"
        }
      ]
    },
    "tracy": {
      "description": "Tracy profiler (option MOTEUR_TRACY): the engine's zones are also sent to Tracy",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false
        }
      ]
    }
  }
}
