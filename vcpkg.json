{
  "name": "moteur",
  "version-string": "0.1.0",
  "builtin-baseline": "5f96cd15fd745122cf27e0524606d6c1efc5fd07",
  "dependencies": [
    "sdl3",
    "glm",
    "stb",
    "doctest",
    "nlohmann-json",
    "cgltf",
    "mikktspace",
    "entt",
    "efsw",
    "miniaudio",
    "ozz-animation",
    {
      "name": "ktx",
      "features": ["tools"]
    },
    {
      "name": "imgui",
      "features": ["sdl3-binding", "sdlgpu3-binding"]
    },
    {
      "name": "sdl3-shadercross",
      "platform": "windows"
    },
    {
      "name": "winpixevent",
      "platform": "windows"
    }
  ],
  "features": {
    "tracy": {
      "description": "Tracy profiler (option MOTEUR_TRACY): the engine's zones are also sent to Tracy",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false
        }
      ]
    }
  }
}
