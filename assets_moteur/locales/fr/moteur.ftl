# Textes du moteur que voit le joueur (jalon 9 bis, partie 5) : noms des commandes, durées.
# Un jeu peut les remplacer par un fichier du même nom dans ses assets.

## Souris et molette

input-mouse-left = Clic gauche
input-mouse-right = Clic droit
input-mouse-middle = Clic milieu
input-mouse-x1 = Souris 4
input-mouse-x2 = Souris 5
input-mouse-other = Souris ?
input-wheel-up = Molette haut
input-wheel-down = Molette bas

