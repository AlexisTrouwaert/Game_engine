# Writes the build information of the engine (milestone 8, part 3): run at every build by the target
# moteur_build_info (cmake -P), it rewrites OUTPUT only when the commit or the state of the working
# tree changed, so that an unchanged checkout rebuilds nothing.
#
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -P BuildInfo.cmake

set(commit "inconnu")
set(date "")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE hash RESULT_VARIABLE failed
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT failed AND hash)
        set(commit "${hash}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
                        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE changes ERROR_QUIET)
        if(changes)
            string(APPEND commit "+")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 --format=%cs
                        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE date
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    endif()
endif()

set(content "// Generated by cmake/BuildInfo.cmake at build time: do not edit.\n\
namespace moteur::build_info {\n\
extern const char* const kCommit;\n\
extern const char* const kCommitDate;\n\
const char* const kCommit = \"${commit}\";\n\
const char* const kCommitDate = \"${date}\";\n\
}\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
