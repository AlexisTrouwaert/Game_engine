// Resources of a game's executable on Windows (cmake/Game.cmake, moteur_add_game): its icon, its
// version information (Properties > Details in the Explorer) and its manifest. Generated by CMake.
#pragma code_page(65001)
#include <winres.h>

@MOTEUR_RC_ICON@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MOTEUR_RC_VERSION_COMMAS@
 PRODUCTVERSION @MOTEUR_RC_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@MOTEUR_RC_PUBLISHER@"
            VALUE "FileDescription", "@MOTEUR_RC_NAME@"
            VALUE "FileVersion", "@MOTEUR_RC_VERSION@"
            VALUE "InternalName", "@MOTEUR_RC_TARGET@"
            VALUE "LegalCopyright", "@MOTEUR_RC_COPYRIGHT@"
            VALUE "OriginalFilename", "@MOTEUR_RC_TARGET@.exe"
            VALUE "ProductName", "@MOTEUR_RC_NAME@"
            VALUE "ProductVersion", "@MOTEUR_RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
