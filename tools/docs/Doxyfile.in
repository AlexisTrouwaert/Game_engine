# The engine's API reference (milestone 8, part 9): the public headers (include/moteur/) only.
# Configured by CMake (target moteur_docs, cmake/Docs.cmake); warnings are errors.
PROJECT_NAME           = "moteur"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "C++20 game engine on SDL3"
OUTPUT_DIRECTORY       = "@MOTEUR_DOCS_OUTPUT@"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = YES
GROUP_NESTED_COMPOUNDS = NO
SUBGROUPING            = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = YES
CASE_SENSE_NAMES       = SYSTEM
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@MOTEUR_ROOT@/src/moteur/include"
STRIP_FROM_INC_PATH    = "@MOTEUR_ROOT@/src/moteur/include"
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_UNDOC_ENUM_VAL = NO
WARN_AS_ERROR          = @MOTEUR_DOCS_WARN_AS_ERROR@
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@MOTEUR_DOCS_OUTPUT@/warnings.txt"
INPUT                  = "@MOTEUR_ROOT@/tools/docs/mainpage.md" "@MOTEUR_ROOT@/src/moteur/include/moteur"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = "@MOTEUR_ROOT@/tools/docs/mainpage.md"
INPUT_ENCODING         = UTF-8
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = YES
ALPHABETICAL_INDEX     = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_SECTIONS  = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = MOTEUR_DOXYGEN                          "MOTEUR_REFLECT(...)="                          "MOTEUR_REFLECT_NAMED(...)="                          "MOTEUR_REFLECT_ENUM(...)="
# The reflection's implementation details (reflection.hpp) are not part of the reference.
EXCLUDE_SYMBOLS        = moteur::reflection_detail moteur::reflection_detail::* moteur::component_detail
SEARCH_INCLUDES        = NO
HAVE_DOT               = NO
CLASS_GRAPH            = YES
